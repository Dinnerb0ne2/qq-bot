# Ignore-file for docker/Dockerfile (BuildKit picks up <dockerfile>.dockerignore
# next to the Dockerfile). Patterns are relative to the build context, which is
# the repo root — NOT this docker/ folder.
#
# Keep the build context (and resulting image) lean — only what `pnpm build`
# needs reaches the daemon. node_modules and dist are rebuilt inside the image.
node_modules
dist
*.tsbuildinfo
.git
.gitignore
.github
.vscode
.idea

# Secrets never belong in the build context.
.env
.env.local
.env.*.local

# Docs / meta not needed to build.
*.md
LICENSE
# Docker assets (Dockerfile, compose, this ignore-file) live here, none needed
# in the build context.
docker

# Logs / caches / editor cruft.
logs
*.log
.cache
tmp
.DS_Store

# Local news database — runtime state, never baked into the image.
data
