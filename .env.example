# QQ official bot credentials (from the developer console at https://q.qq.com)
BOT_APPID=your_app_id
BOT_SECRET=your_app_secret

# Use the sandbox environment (true/false), default false
BOT_SANDBOX=false

# Log level: trace | debug | info | warn | error, default info
LOG_LEVEL=info

# --- Ad moderation ---
# Ad offenses by one member before an alert message is sent (default 3)
AD_STRIKE_LIMIT=3

# Forbidden words, intensity and the statistical probability params live in
# config/ad.json (the single source of truth, edited at runtime without
# touching source code). Override the file path with AD_CONFIG_PATH if you keep
# it elsewhere.
# AD_CONFIG_PATH=config/ad.json

# Remote ad rules, unioned on top of config/ad.json. By DEFAULT the bot fetches
# this repo's own hand-editable docs/ad-rules.txt — a single file with
# [keywords] and [patterns] sections — so you can curate by editing that file
# and pushing (no redeploy). A failed fetch leaves the config-file lists in effect.
#   - override with your own URL:  AD_RULES_URL=https://example.com/rules.txt
#   - disable remote rules:        AD_RULES_URL=   (empty)
# AD_RULES_URL=
# How often to refresh the remote rules file, in minutes (default 360 = 6h)
# AD_RULES_REFRESH_MINUTES=360

# --- news command ---
# A scheduled job summarizes the day's AI news once daily; the `news` command
# only serves the stored result (no LLM call on demand).
#
# API key for the summarizer LLM (DeepSeek's Anthropic-compatible endpoint).
# Required to run the daily job; when unset the job is disabled and `news`
# replies that no summary is available. NEWS_LLM_API_KEY takes precedence over
# DEEPSEEK_API_KEY.
NEWS_LLM_API_KEY=

# Anthropic-compatible endpoint + model (default DeepSeek deepseek-v4-pro)
# NEWS_LLM_BASE_URL=https://api.deepseek.com/anthropic
# NEWS_MODEL=deepseek-v4-pro
# Max output tokens for a summary request (default 64000)
# NEWS_MAX_TOKENS=64000

# OPML file listing the RSS/Atom feeds to poll (default: the iread feeds in
# isomoes/arch-config). A github.com /blob/ URL is auto-rewritten to raw form.
# NEWS_OPML_URL=https://raw.githubusercontent.com/isomoes/arch-config/master/iread/feeds.opml

# Offline fallback feeds if the OPML can't be fetched, comma/newline separated.
# Also overrides the fallback list (see src/config.ts).
# NEWS_FEEDS=https://news.smol.ai/rss.xml,https://simonwillison.net/atom/everything/

# SQLite database file for fetched news items (default data/news.db). In Docker
# this lives on the ./data volume — see docker/docker-compose.yml.
# NEWS_DB_PATH=data/news.db

# Max items per day handed to the summarizer (default 30)
# NEWS_MAX_ITEMS=30

# How far back (hours) a run collects items (default 24). Raise it if feeds are
# quiet and a run reports "No news in the last 24h"; >24 makes consecutive daily
# digests overlap.
# NEWS_LOOKBACK_HOURS=24

# Hour of day (UTC+8, 0-23) at which the daily summary job runs (default 22)
# NEWS_SUMMARY_HOUR=22

# Auto-push the daily summary to these groups as soon as it is generated
# (comma or newline separated group openids; empty/unset disables pushing).
# A group openid is the opaque id in the `recv from Group(...)` log line —
# @mention the bot in the target group and copy it from the logs; it is NOT
# the QQ group number shown in the client. Pushes are "active" messages: the
# group owner must enable 机器人主动在群聊内发言 in the group's robot settings
# (available platform-wide since 2026-06-22), or sends fail with code 40034102.
# NEWS_PUSH_GROUPS=

# Allow the on-demand `news refresh` command (re-runs the job now). The `dev`
# npm script sets this to true automatically; production leaves it off. Set to
# true here only if you want manual refresh enabled outside `npm run dev`.
# NEWS_MANUAL_REFRESH=true

# Language the summary is written in (default Chinese)
# NEWS_LANG=Chinese
