# QQ official bot credentials (from the developer console at https://q.qq.com)
BOT_APPID=your_app_id
BOT_SECRET=your_app_secret

# Use the sandbox environment (true/false), default false
BOT_SANDBOX=false

# Log level: trace | debug | info | warn | error, default info
LOG_LEVEL=info

# --- Ad moderation ---
# Ad offenses by one member before an alert message is sent (default 3)
AD_STRIKE_LIMIT=3
# Minimum distinct ad keywords in a message to flag it as an ad (default 2)
AD_MIN_KEYWORD_HITS=2

# Remote ad rules, unioned with the built-in lists. By DEFAULT the bot fetches
# this repo's own hand-editable docs/ad-rules.txt — a single file with
# [keywords] and [patterns] sections — so you can curate by editing that file
# and pushing (no redeploy). A failed fetch leaves the built-in lists in effect.
#   - override with your own URL:  AD_RULES_URL=https://example.com/rules.txt
#   - disable remote rules:        AD_RULES_URL=   (empty)
# AD_RULES_URL=
# How often to refresh the remote rules file, in minutes (default 360 = 6h)
# AD_RULES_REFRESH_MINUTES=360
